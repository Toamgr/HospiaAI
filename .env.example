# AI — Gemini (primary AI provider). Server-side only. Do NOT use VITE_ prefix.
GEMINI_API_KEY=PASTE_KEY_HERE
MODEL=gemini-2.5-flash-lite

# AI — OpenAI (legacy/secondary). Server-side only.
OPENAI_API_KEY=PASTE_KEY_HERE

# AI — Replicate (image generation). Server-side only.
REPLICATE_API_TOKEN=PASTE_KEY_HERE

# Server
PORT=3001
# Set NODE_ENV=production when deploying so Express serves the built frontend from /dist.
NODE_ENV=production

# Email — Gmail SMTP. Generate App Password at https://myaccount.google.com/apppasswords (requires 2FA)
EMAIL_USER=your@email.com
EMAIL_PASS=your-app-password
